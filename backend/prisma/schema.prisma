generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  DEVELOPER
  ORGANIZER
  SCANNER
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OrganizationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum OrganizationType {
  TEATRO
  PRODUCTORA
  CENTRO_CULTURAL
  MUNICIPALIDAD
  CLUB
  EMPRESA
  INDEPENDIENTE
  OTRO
}

enum EventStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  CANCELLED
  FINISHED
}

enum EventVisibility {
  PUBLIC
  PRIVATE
}

enum FunctionStatus {
  SCHEDULED
  CANCELLED
  FINISHED
}

enum ConversationChannel {
  WEB
  WHATSAPP
}

enum ConversationStatus {
  ACTIVE
  DRAFT_SAVED
  PUBLISHED
  ABANDONED
}

enum SaleStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

// SALE = venta real (paga o manual, el flujo de siempre). COURTESY = emitida
// por un organizador desde el módulo Cortesías, sin costo — ver
// CourtesyIssuance más abajo para el resto de sus datos (motivo, quién la
// emitió, cómo se entregó). Todo lo demás de Sale/Ticket/QR/Scanner/CheckIn
// es IDÉNTICO para ambos orígenes: una cortesía es un Ticket normal, esto
// es sólo la etiqueta mínima para distinguir de dónde vino.
enum SaleOrigin {
  SALE
  COURTESY
}

enum PaymentMethod {
  MANUAL
  MERCADO_PAGO
}

// Estado del envío del email de confirmación (Resend) — independiente del
// estado de la venta en sí. SENDING es un "lock" transitorio: lo toma la
// operación atómica que reclama el intento (ver claimSaleConfirmationEmail
// en sendSaleConfirmationEmail.service.js) para que dos llamadas
// concurrentes a confirmSaleService/reintento nunca manden el mismo correo
// dos veces. Si queda SENDING por una caída del proceso a mitad de camino,
// se considera "stale" pasados unos minutos y vuelve a ser reclamable.
enum EmailDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
  REFUNDED
}

enum ScanResult {
  VALID
  ALREADY_USED
  CANCELLED
  NOT_FOUND
  WRONG_EVENT
}

model User {
  id            String         @id @default(cuid())
  // Nullable a propósito: un comprador invitado (checkout sin cuenta) crea
  // una fila acá con clerkId null, sólo email/nombre. Postgres permite
  // varios NULL en una columna @unique, así que conviven sin conflicto. Si
  // esa persona más adelante crea una cuenta real con el mismo email,
  // syncUserService "adopta" esta misma fila en vez de duplicarla — sus
  // compras previas (Sale/Ticket.buyerId) quedan ligadas automáticamente.
  clerkId       String?        @unique
  email         String         @unique
  firstName     String?
  lastName      String?
  imageUrl      String?
  role          Role           @default(CUSTOMER)
  status        UserStatus     @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  organizations Organization[]

  salesAsBuyer    Sale[]
  ticketsAsBuyer  Ticket[]       @relation("TicketBuyer")
  ticketsAsOwner  Ticket[]       @relation("TicketOwner")
  // Cortesías que este usuario emitió como organizador (nunca como
  // comprador/destinatario — eso ya lo cubre salesAsBuyer).
  courtesyIssuances CourtesyIssuance[]
  // Cambios de número de WhatsApp autorizado que este usuario inició desde
  // el panel Web (nunca desde WhatsApp) — ver WhatsappNumberChangeChallenge.
  whatsappNumberChangeRequests WhatsappNumberChangeChallenge[]
  // MP-1 — intentos de autorización OAuth de Mercado Pago que este usuario
  // inició (ver MercadoPagoOAuthState).
  mercadoPagoOAuthStatesRequested MercadoPagoOAuthState[]
  // MP-6 — trazabilidad de quién guardó por última vez cada rango de
  // ServiceFeeTier (ver ese modelo más abajo). Sólo DEVELOPER puede llegar
  // a aparecer acá (requireRole en developerServiceFee.routes.js).
  serviceFeeTiersUpdated ServiceFeeTier[]
}

model Organization {
  id          String            @id @default(cuid())
  name        String
  type        OrganizationType?
  description String?
  logo        String?
  phone       String?
  email       String
  website     String?
  instagram   String?
  facebook    String?
  tiktok      String?
  province    String?
  city        String?
  cuit        String?

  responsibleFirstName String?
  responsibleLastName  String?
  responsibleDni       String?

  status     OrganizationStatus @default(PENDING)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  approvedAt DateTime?
  approvedBy String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  events Event[]

  // Fase 2F — vínculo WhatsApp ↔ organizer. La verificación del código de
  // vinculación llega SOLO como {code} (nunca waId/organizationId, ver
  // whatsappOrganizerLink.service.js), así que no hay una fila de
  // challenge a la que poder atribuirle intentos fallidos de un código
  // que no matchea ningún hash existente — por eso el contador de
  // intentos vive acá, en la organización autenticada que está
  // verificando, no en WhatsappLinkChallenge. Se resetea a (0, null)
  // apenas la organización vincula con éxito, y también "se resetea
  // solo" por ventana de tiempo (ver evaluateOrganizationLinkAttempts):
  // no hay bloqueo permanente.
  whatsappLinkAttempts   Int       @default(0)
  whatsappLinkAttemptsAt DateTime?

  whatsappOrganizerLink WhatsappOrganizerLink?
  // Cambio de número de WhatsApp autorizado EN CURSO para esta organización
  // (a lo sumo uno a la vez) — ver WhatsappNumberChangeChallenge. Nunca es
  // el vínculo ya verificado (eso es whatsappOrganizerLink de arriba).
  whatsappNumberChangeChallenge WhatsappNumberChangeChallenge?

  // MP-1 — vinculaciones OAuth con cuenta(s) de Mercado Pago de ESTA
  // organización (ver MercadoPagoConnection). Lista, no un solo opcional:
  // desde el bug fix de desconexión, cada conexión real (primera vez,
  // reconexión, desconexión) es su propia fila — a lo sumo UNA con
  // status:ACTIVE en un momento dado, pero puede haber varias DISCONNECTED
  // históricas (nunca se sobreescriben ni se borran, ver el comentario en
  // MercadoPagoConnection). `mercadoPagoOAuthStates` son los intentos de
  // autorización EN CURSO (nunca una conexión ya establecida) — puede
  // haber más de uno vivo a la vez (ej. el organizador abre "Conectar
  // Mercado Pago" en dos pestañas), a diferencia del cambio de número de
  // WhatsApp, que sí exige un único intento pendiente.
  mercadoPagoConnections MercadoPagoConnection[]
  mercadoPagoOAuthStates MercadoPagoOAuthState[]
}

// Fase 2F — challenge efímero para vincular un wa_id a una organización.
// Vive independiente de cualquier organización/usuario porque se crea
// DESDE WhatsApp, antes de que exista ninguna sesión Clerk involucrada: en
// ese momento sólo se conoce el wa_id. codeHash es SHA-256 del código de 6
// dígitos (ver utils/verificationCode.js) — el código en texto plano nunca
// se persiste, sólo se devuelve una vez para poder mandarlo por WhatsApp.
// Una fila por wa_id (@unique): un código nuevo reemplaza al anterior bajo
// cooldown (ver shouldCreateNewChallenge), nunca conviven dos códigos
// vivos para el mismo número.
model WhatsappLinkChallenge {
  id         String   @id @default(cuid())
  waId       String   @unique
  codeHash   String
  expiresAt  DateTime
  lastSentAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("whatsapp_link_challenges")
}

// Fase 2F: vínculo verificado por código — infraestructura legacy, ya no la
// alimenta ningún flujo normal (ver Fase 2G). Fase 2G: pasa a ser la fila
// que representa "esta Organization quedó asociada a este wa_id", creada
// automáticamente al descubrirla por Organization.phone (ver
// whatsappOrganizerDiscovery.service.js), nunca más por código.
// organizationId sigue @unique: una Organization tiene, como máximo, un
// WhatsApp asociado — una vez que existe una fila para una Organization,
// esa Organization deja de ser candidata de descubrimiento para cualquier
// otro wa_id (nunca se reasigna/pisa). waId YA NO es @unique: el mismo
// número puede operar sobre varias Organizations (una fila por cada una),
// que es exactamente el caso que antes esta constraint impedía. @@index
// reemplaza al índice único implícito para que buscar "los vínculos de
// este wa_id" (ahora potencialmente varios) siga siendo barato.
model WhatsappOrganizerLink {
  id             String       @id @default(cuid())
  waId           String
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id])
  verifiedAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([waId])
  @@map("whatsapp_organizer_links")
}

enum WhatsappNumberChangePurpose {
  CHANGE_WHATSAPP_NUMBER
}

// Cambio seguro del NÚMERO AUTORIZADO para administrar una organización por
// WhatsApp (nunca Organization.phone, que es el teléfono público/de
// contacto — ver whatsappNumberChange.service.js). Mismo criterio de "una
// fila viva por clave, reemplazada bajo cooldown, borrada al resolverse"
// que WhatsappLinkChallenge/WhatsappPendingOrganizationSelection — nunca un
// status persistido para "expirado" (se compara expiresAt contra `now` en
// el momento de usarlo), y nunca el código en texto plano (sólo codeHash).
//
// organizationId es @unique A PROPÓSITO (a diferencia de WhatsappLinkChallenge,
// que indexaba por waId): acá el disparador SIEMPRE es un usuario Web ya
// autenticado que ya sabe para qué organización está pidiendo el cambio
// (nunca se infiere con findFirst) — como mucho un cambio pendiente por
// organización a la vez, nunca dos challenges compitiendo por la misma.
//
// requestedByUserId es la fila interna de User (resuelta desde la sesión
// Clerk autenticada, nunca del body) que inició el pedido — junto con
// organizationId, es lo que permite reconfirmar identidad/organización
// antes de migrar (nunca se confía únicamente en el código).
//
// oldWaId es una COPIA del WhatsappOrganizerLink.waId vigente al crear el
// challenge (null si la organización todavía no tenía ningún número
// autorizado) — un snapshot, no una referencia viva: es lo que permite, al
// verificar, cerrar la conversación y limpiar selecciones pendientes de ESE
// número puntual sin tener que volver a leerlo (y sin arriesgar que haya
// cambiado en el medio).
//
// purpose es explícito (un solo valor hoy) para que un código de esta tabla
// nunca pueda interpretarse como válido para otra operación futura que
// también use códigos de 6 dígitos — la distinción es ESTRUCTURAL (una fila
// de esta tabla sólo puede significar esto), no una comparación de valores
// que alguien podría olvidarse de chequear.
model WhatsappNumberChangeChallenge {
  id                String                       @id @default(cuid())
  organizationId    String                       @unique
  organization      Organization                 @relation(fields: [organizationId], references: [id])
  requestedByUserId String
  requestedByUser   User                         @relation(fields: [requestedByUserId], references: [id])
  purpose           WhatsappNumberChangePurpose  @default(CHANGE_WHATSAPP_NUMBER)
  oldWaId           String?
  newWaId           String
  codeHash          String
  attempts          Int                          @default(0)
  expiresAt         DateTime
  lastSentAt        DateTime
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@map("whatsapp_number_change_challenges")
}

enum WhatsappPendingSelectionStatus {
  AWAITING_SELECTION
  AWAITING_CONFIRMATION
}

// Fase 2G — estado ínfimo y explícito de "este wa_id todavía no terminó de
// elegir con qué Organization va a trabajar". La fila EXISTE mientras dura
// la espera y se borra apenas se resuelve (elección confirmada, "No", o un
// mensaje cancela el flujo) — nunca se infiere nada a partir de cuánto
// tiempo pasó desde createdAt/updatedAt (ver informe de entrega, sección
// "esperando selección de organización").
//
// candidateOrganizationIds es la lista EXACTA, en el mismo orden en que se
// le mostró al usuario en el mensaje numerado (JSON array de organizationId)
// — nunca se vuelve a calcular desde Organization.phone al validar una
// elección, para que un cambio de estado de alguna Organization entre el
// mensaje numerado y la respuesta no le corra el número a nadie.
//
// AWAITING_SELECTION: se mostró la lista, se espera un número válido.
// AWAITING_CONFIRMATION: ya se resolvió selectedOrganizationId (por
// selección explícita entre N candidatas), se espera el "Sí"/"No" final
// antes de recién ahí llamar a EventCreationEngine.start.
model WhatsappPendingOrganizationSelection {
  id                       String                         @id @default(cuid())
  waId                     String                         @unique
  status                   WhatsappPendingSelectionStatus
  candidateOrganizationIds Json
  selectedOrganizationId   String?
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt

  @@map("whatsapp_pending_organization_selections")
}

// ==================================================================
// MP-1 — onboarding OAuth de Mercado Pago (Organization ↔ OAuth ↔ Mercado
// Pago). Esta fase ÚNICAMENTE conecta la cuenta: no hay preferencias de
// pago, Checkout, Split Payment ni webhooks de cobro todavía — eso es
// MP-2, sobre esta misma tabla, ver el informe de entrega de MP-1.
// ==================================================================

// Token efímero de protección CSRF para el flujo OAuth — NUNCA la conexión
// ya establecida (eso es MercadoPagoConnection, más abajo). Mercado Pago
// no valida el parámetro `state` de ninguna forma (confirmado contra su
// documentación oficial: es responsabilidad exclusiva de la aplicación que
// integra) — esta tabla es la única fuente de verdad de "qué Organization,
// con qué usuario autenticado, inició este intento de autorización, y
// sigue siendo válido".
//
// stateToken es el valor real que viaja como `state` en la authorization
// URL: aleatorio de alta entropía (32 bytes vía crypto.randomBytes, ver
// mercadoPagoConnection.service.js), @unique, sin ninguna otra función más
// que autorizar ESTE callback puntual — mismo criterio que
// Sale.publicRecoveryToken/EventScanner.invitationToken. Nunca se infiere
// nada serializado adentro del propio token (nunca "organizationId
// encodeado sin firmar"): la única forma de resolver a qué Organization
// corresponde es esta fila.
//
// Se borra al consumirse (callback exitoso) o al descartarse — nunca un
// status persistido para "expirado", se compara expiresAt contra `now` en
// el momento de usarlo (mismo criterio que WhatsappLinkChallenge/
// WhatsappNumberChangeChallenge). A diferencia de esas dos tablas,
// organizationId NO es @unique acá: pueden convivir varios intentos de
// autorización vivos para la misma Organization sin conflicto (ej. el
// organizador abrió "Conectar Mercado Pago" en dos pestañas) — cada
// stateToken es independiente y de un solo uso por sí mismo.
model MercadoPagoOAuthState {
  id                String       @id @default(cuid())
  stateToken        String       @unique
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  requestedByUserId String
  requestedByUser   User         @relation(fields: [requestedByUserId], references: [id])
  expiresAt         DateTime
  createdAt         DateTime     @default(now())

  @@index([organizationId])
  @@map("mercado_pago_oauth_states")
}

// La vinculación entre una Organization y una cuenta de Mercado Pago.
//
// Bug fix (desconexión de Mercado Pago) — organizationId DEJÓ de ser
// @unique: antes había a lo sumo UNA fila por Organization para siempre
// (upsert en el callback la sobreescribía en el lugar en cada reconexión,
// tokens viejos incluidos). Eso rompía dos cosas: (1) un webhook TARDÍO de
// un payment cobrado con la cuenta A ya no podía resolverse una vez que la
// Organization se desconectaba y reconectaba con la cuenta B, porque el
// access_token/mercadoPagoUserId de A ya no existían en ningún lado
// (sobreescritos); (2) reconectar por error a una cuenta distinta (ver el
// incidente real que motivó este cambio) no dejaba ningún rastro de la
// cuenta anterior. Ahora cada conexión real (primera vez, reconexión,
// desconexión) es su PROPIA fila — nunca se sobreescribe una fila
// existente — así que el historial completo de credenciales queda
// disponible para reconciliar pagos viejos. `status` reemplaza al
// borrado/upsert: sólo puede haber, como mucho, UNA fila ACTIVE por
// Organization en un momento dado (garantizado por un advisory lock de
// Postgres al conectar/desconectar, ver mercadoPagoConnection.service.js —
// mismo mecanismo que ya usa MP-2.1 para reservar stock, nunca un índice
// único parcial hecho a mano). Filas DISCONNECTED se conservan tal cual
// (mismos tokens cifrados) exclusivamente para que un webhook tardío de
// esa cuenta pueda seguir resolviéndose — nunca se usan para cobrar nada
// nuevo (getValidMercadoPagoAccessTokenForOrganization sólo mira ACTIVE).
//
// accessToken/refreshToken viajan SIEMPRE cifrados (AES-256-GCM, ver
// config/mercadoPagoEncryption.js) — nunca en texto plano, nunca
// devueltos por ningún endpoint (ver mercadoPagoConnection.service.js,
// que expone exclusivamente campos no sensibles).
//
// mercadoPagoUserId es el `user_id` que Mercado Pago devuelve en la
// respuesta OAuth (el "collector id" del vendedor) — no es secreto (es
// sólo un identificador de cuenta, no una credencial), así que SÍ se
// expone en el status para que el organizador pueda confirmar qué cuenta
// quedó vinculada. publicKey/liveMode/scope se guardan porque vienen
// gratis en la MISMA respuesta que ya hay que persistir.
//
// accessTokenExpiresAt se calcula al persistir (now + expires_in
// segundos, hoy 180 días según la documentación oficial). refreshToken
// ROTA en cada renovación real (confirmado contra la documentación
// oficial) — connectedAt se fija al crear la fila (primera vez o
// reconexión); updatedAt (@updatedAt) refleja la última renovación real.
enum MercadoPagoConnectionStatus {
  ACTIVE
  DISCONNECTED
}

model MercadoPagoConnection {
  id                     String                      @id @default(cuid())
  organizationId         String
  organization           Organization                @relation(fields: [organizationId], references: [id])
  mercadoPagoUserId      String
  publicKey              String?
  accessTokenEncrypted   String
  refreshTokenEncrypted  String
  scope                  String?
  liveMode               Boolean                     @default(false)
  accessTokenExpiresAt   DateTime
  status                 MercadoPagoConnectionStatus @default(ACTIVE)
  connectedAt            DateTime                    @default(now())
  disconnectedAt         DateTime?
  updatedAt              DateTime                    @updatedAt

  @@index([organizationId])
  @@index([mercadoPagoUserId])
  @@map("mercado_pago_connections")
}

model Event {
  id             String  @id @default(cuid())
  title          String
  slug           String  @unique
  category       String?
  // Solo se usa cuando category = "OTRO", para mostrarle al público un nombre
  // propio sin perder la consistencia de la categoría principal en la base de datos.
  customCategory String?

  shortDescription String?
  description      String?
  coverImage       String?

  // Campos legacy denormalizados (se mantienen sincronizados con la ubicación
  // de Google Maps de abajo) para no romper el marketplace público existente.
  venue    String?
  address  String?
  city     String?
  province String?

  // Ubicación con Google Maps (Places + Geocoding). venueName/formattedAddress/
  // addressLine/latitude/longitude son obligatorios solo para publicar el evento.
  venueName        String?
  formattedAddress String?
  addressLine      String?
  country          String?
  postalCode       String?
  latitude         Float?
  longitude        Float?
  googlePlaceId    String?

  startDate   DateTime?
  endDate     DateTime?
  doorsOpenAt DateTime?

  isFree Boolean @default(false)

  status      EventStatus     @default(DRAFT)
  visibility  EventVisibility @default(PUBLIC)
  publishedAt DateTime?

  // Cuándo pasó a CANCELLED — necesario para la regla de archivado
  // automático ("cancelado + 7 días"), que nunca podría usar `updatedAt`
  // para esto: se pisa con cualquier otra edición posterior, no sólo con la
  // cancelación (mismo motivo por el que EventScanner.lastScanAt no sirve
  // para "último escaneo" — ver eventScanner.service.js). Se limpia a null
  // si el estado vuelve a cambiar a otra cosa (updateMyEventService).
  cancelledAt DateTime?

  // Cuándo pasó al Historial de Eventos (archivado automático, ver
  // eventArchive.service.js). Nullable = no archivado. Nunca se borra un
  // evento archivado ni se le pierde información — sólo deja de aparecer en
  // las pantallas operativas del organizador.
  archivedAt DateTime?

  createdBy String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  functions   EventFunction[]
  ticketTypes TicketType[]
  links       EventLink[]

  sales    Sale[]
  tickets  Ticket[]
  scanners EventScanner[]
}

// Enlaces relacionados con el evento, los artistas o la organización
// (redes sociales, video promocional, Spotify, sitio web, etc).
// "type" es un String libre (no un enum) para poder sumar nuevos tipos
// desde el frontend sin necesidad de migrar la base de datos. Es la
// plataforma detectada automáticamente por MediaParser (INSTAGRAM,
// YOUTUBE, TIKTOK, etc) a partir de la URL pegada por el organizador.
model EventLink {
  id String @id @default(cuid())

  type  String
  title String?
  url   String
  order Int     @default(0)

  // Resultado de MediaParser al momento de guardar, para no tener que
  // volver a detectar la plataforma cada vez que se muestra el enlace.
  embedUrl     String?
  thumbnail    String?
  isEmbeddable Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_links")
}

// Una función representa una fecha/horario concreto de un Event.
// Los precios y el stock viven en TicketType (catálogo del Event), nunca en Event ni en EventFunction.
model EventFunction {
  id String @id @default(cuid())

  date        DateTime
  doorsOpenAt DateTime?
  endAt       DateTime?
  venue       String
  address     String?
  capacity    Int?

  status FunctionStatus @default(SCHEDULED)

  // Agrupa funciones generadas juntas por recurrencia, para poder aplicar
  // ediciones con alcance "esta y las siguientes" / "todas" (estilo Google Calendar).
  recurrenceGroupId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  ticketAssignments FunctionTicketType[]
  sales             Sale[]
  tickets           Ticket[]

  @@map("event_functions")
}

// Catálogo reutilizable de entradas del Event. Las funciones seleccionan
// qué entradas del catálogo usan a través de FunctionTicketType.
model TicketType {
  id String @id @default(cuid())

  name           String
  price          Decimal @db.Decimal(10, 2)
  quantity       Int
  maxPerPurchase Int     @default(10)
  description    String?
  visible        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  assignments FunctionTicketType[]
  saleItems   SaleItem[]
  tickets     Ticket[]

  @@map("ticket_types")
}

// Asignación de una entrada del catálogo a una función puntual, con
// posibilidad de sobrescribir precio/cantidad/visibilidad para esa función.
model FunctionTicketType {
  id String @id @default(cuid())

  enabled          Boolean  @default(true)
  priceOverride    Decimal? @db.Decimal(10, 2)
  quantityOverride Int?
  visibleOverride  Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  functionId String
  function   EventFunction @relation(fields: [functionId], references: [id], onDelete: Cascade)

  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@unique([functionId, ticketTypeId])
  @@map("function_ticket_types")
}

// Estado persistido del Event Creation Engine: guarda en qué paso del flujo
// conversacional está un usuario y todo lo que respondió hasta ahora
// (draftEvent), para poder retomar la conversación desde cualquier canal.
// El Event real recién se crea en EventService cuando el usuario confirma
// "Publicar" o "Guardar borrador" (ver EventCreationEngine/EventServicePort).
model ConversationState {
  id             String              @id @default(cuid())
  userId         String?
  channel        ConversationChannel
  channelRef     String
  // Fase 2G — sólo WhatsApp la completa hoy (resuelta antes de llamar
  // EventCreationEngine.start, ver whatsapp.controller.js); Web la deja
  // null y conserva el comportamiento legacy de getMyOrganization(clerkId)
  // (findFirst) en toda la cadena de event.service.js. Persistida acá para
  // que, aunque el organizador tenga varias Organizations, la elegida al
  // empezar la conversación sea la MISMA en cada paso siguiente hasta
  // EventServicePort.commit — nunca se vuelve a resolver "de nuevo" a mitad
  // de camino.
  organizationId String?
  currentStepId  String
  loopStack      Json                @default("[]")
  draftEvent     Json                @default("{}")
  history        Json                @default("[]")
  status         ConversationStatus  @default(ACTIVE)
  eventId        String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // Fase 3B — estado temporal EXCLUSIVO del adaptador WhatsApp para
  // construir, de a un mensaje por vez, un input compuesto que el motor
  // sólo acepta completo (ej. FUNCTION_CARD: fecha+hora inicio+hora fin).
  // Sólo el campo de relación va acá (no agrega ninguna columna física a
  // esta tabla) — la FK real vive del lado de WhatsappPendingStepInput,
  // mismo patrón que Organization.whatsappOrganizerLink más abajo.
  whatsappPendingStepInput WhatsappPendingStepInput?

  @@map("conversation_states")
}

// Fase 3B — infraestructura pura, todavía sin consumir desde
// whatsapp.controller.js (ver informe de entrega): un "borrador de
// respuesta" para un step del motor que WhatsApp decide partir en varias
// preguntas de texto (fecha, después hora de inicio, después hora de fin;
// más adelante dirección manual, entradas, etc.) — NUNCA se escribe nada de
// esto en ConversationState.draftEvent mientras está incompleto, porque el
// motor asume que todo lo que hay en draftEvent ya fue confirmado por un
// step real. Recién cuando el sub-flujo completo arma el objeto exacto que
// exige el inputHandler correspondiente, el adaptador llama a
// EventCreationEngine.handleInput UNA vez — este modelo no existe para el
// motor, sólo para el canal.
//
// conversationId es @unique (1:1 real con ConversationState, nunca varios
// pendientes por conversación) y tiene onDelete: Cascade — cancelar la
// conversación (EventCreationEngine.cancel -> prisma.conversationState.delete)
// borra este registro solo, sin necesidad de limpieza manual en el
// controller.
//
// stepId es la fuente de verdad de "para qué pregunta del motor es este
// borrador": si la conversación ya avanzó a otro currentStepId, un pending
// con un stepId viejo NUNCA se reutiliza silenciosamente (ver
// whatsappPendingStepInput.service.js#getValidPendingStepInput) — se
// descarta y se arranca uno nuevo. No se infiere nada por antigüedad
// (createdAt/updatedAt): sólo se usan para trazabilidad, nunca como
// mecanismo de invalidación.
//
// status es String (no enum) A PROPÓSITO: todavía no sabemos cuántos
// sub-pasos van a existir (AWAITING_DATE, AWAITING_START_TIME,
// AWAITING_STREET, AWAITING_CITY...) y un enum de Postgres exige una
// migración nueva por cada valor que se agregue a futuro. Un String no
// tiene ese costo — las fases siguientes agregan sub-pasos como simples
// constantes en el código del adaptador, nunca tocando este modelo.
model WhatsappPendingStepInput {
  id                String            @id @default(cuid())
  conversationId    String            @unique
  conversationState ConversationState @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  stepId            String
  status            String
  partialData       Json              @default("{}")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("whatsapp_pending_step_inputs")
}

enum WhatsappInboundMessageClaimStatus {
  PROCESSING
  COMPLETED
  FAILED
}

// Fase CIERRE (idempotencia de mensajes entrantes) — Meta entrega mensajes
// "at-least-once": una falla de red, un timeout de nuestro lado devolviendo
// el 200 tarde, o un simple reintento del panel de pruebas pueden hacer que
// el MISMO wamid llegue más de una vez a receiveWhatsappWebhook. Esta tabla
// es el único mecanismo de "¿ya procesé este wamid, o lo estoy procesando
// ahora mismo?" — ver
// services/whatsappInboundMessageClaim.service.js#claimInboundMessage,
// único punto que la lee/escribe. NUNCA guarda el payload, el texto del
// usuario, el teléfono ni contenido multimedia: sólo el identificador
// técnico de Meta (wamid) y el estado del reclamo.
//
// wamid es @unique a propósito: el `create` inicial (ver el service) usa
// esa restricción para reclamar atómicamente en UNA sola escritura, sin
// ninguna lectura previa — el camino feliz (wamid nuevo) nunca paga el
// costo de un SELECT antes de poder escribir.
//
// Ciclo de estados:
//   PROCESSING -> COMPLETED  la entrega terminó con éxito; ese wamid nunca
//                            vuelve a procesarse, ni aunque venza el lease.
//   PROCESSING -> FAILED     la entrega tiró una excepción real; queda
//                            reintentable DE INMEDIATO por una reentrega
//                            posterior del mismo wamid (nunca hace falta
//                            esperar a que venza leaseExpiresAt).
//   PROCESSING (sin transición, leaseExpiresAt vencido) — el proceso murió
//                            a mitad de camino (crash real, no una
//                            excepción capturada) — también reintentable,
//                            pero recién una vez pasado leaseExpiresAt, para
//                            no robarle el reclamo a una entrega que sigue
//                            legítimamente en curso.
//
// attempts cuenta cuántas veces se RECLAMÓ (create inicial + cada reclamo
// ganador de un estado FAILED/PROCESSING-vencido) — nunca cuántas veces
// Meta reentregó el webhook, que puede ser mayor (una reentrega que
// encuentra el reclamo todavía vigente ni siquiera llega a tocar esta fila).
//
// Sin cron de limpieza en esta fase (fuera de alcance) — @@index([status,
// leaseExpiresAt]) deja lista, sin escanear toda la tabla, la consulta que
// una futura política de retención necesitaría (ej. "borrar COMPLETED/
// FAILED de más de N días", o encontrar leases PROCESSING vencidos para
// observabilidad).
model WhatsappInboundMessageClaim {
  id             String                             @id @default(cuid())
  wamid          String                             @unique
  status         WhatsappInboundMessageClaimStatus  @default(PROCESSING)
  attempts       Int                                @default(1)
  leaseExpiresAt DateTime
  createdAt      DateTime                           @default(now())
  updatedAt      DateTime                           @updatedAt

  @@index([status, leaseExpiresAt])
  @@map("whatsapp_inbound_message_claims")
}

// Una venta. Nace en PENDING (reserva) y pasa a CONFIRMED cuando se
// confirma el pago (hoy: manual por el organizador; mañana: webhook de
// Mercado Pago) — ver SaleService.confirmSale(). El stock disponible se
// calcula siempre en el momento (quantity del TicketType/override menos
// tickets no cancelados de esa función), nunca se decrementa un contador:
// eso es lo que deja la puerta abierta a reservas temporales a futuro sin
// rediseñar este modelo (contar también PENDING no vencidas).
model Sale {
  id            String        @id @default(cuid())
  status        SaleStatus    @default(PENDING)
  paymentMethod PaymentMethod @default(MANUAL)
  // @default(SALE) a propósito: cero impacto en las filas existentes, y
  // todo el código que ya arma/lee una Sale sigue funcionando sin saber que
  // este campo existe. Sólo lo mira el módulo Cortesías (para no mezclarse
  // con listados/estadísticas de ventas reales) y CourtesyIssuance (su
  // compañera 1:1 cuando origin = COURTESY).
  origin        SaleOrigin    @default(SALE)

  // Credencial pública para que el comprador invitado (sin sesión) recupere
  // esta venta puntual desde el navegador — confirm-by-buyer y status se
  // resuelven por ESTE campo, nunca por `id`. Separado a propósito: `id` es
  // la clave primaria interna (aparece en URLs de organizador, logs,
  // relaciones); este token es aleatorio de alta entropía (32 bytes,
  // crypto.randomBytes en sale.service.js) y no tiene ninguna otra función
  // más que autorizar esta recuperación puntual. Nullable porque las ventas
  // creadas antes de este campo no tienen valor — no hace falta backfill,
  // esas ventas viejas ya entregaron sus tickets en su momento.
  publicRecoveryToken String? @unique

  // MP-2.1 — reserva temporal de stock. NULL para ventas que nunca
  // reservaron nada (filas anteriores a esta fase). Mientras
  // status=PENDING Y stockReservedUntil > ahora, esta Sale cuenta como
  // "indisponible" para functionCapacity.service.js#getUnavailableCount,
  // exactamente igual que un Ticket ya emitido — así dos compradores nunca
  // pueden reservar la misma última unidad al mismo tiempo (ver
  // sale.service.js#createSaleForBuyer, bajo advisory lock). Vencida la
  // reserva, deja de contar SOLA (nunca se escribe un status "EXPIRED" acá
  // por un cron — mismo criterio que MercadoPagoOAuthState/
  // WhatsappNumberChangeChallenge: expiresAt se compara contra `now` en el
  // momento de usarlo, nunca un campo que haya que barrer).
  stockReservedUntil DateTime?

  // MP-2.1 — identificador opaco que se le manda a Mercado Pago como
  // external_reference. Deliberadamente NO es publicRecoveryToken: ese
  // campo es un bearer token que autoriza confirm-by-buyer/status/pdf/
  // resend-email — mandárselo a un tercero (Mercado Pago, sus logs, su
  // soporte) sería entregar una credencial de recuperación real a cambio
  // de un simple id de correlación. Este campo, en cambio, no autoriza
  // nada por sí mismo en ningún endpoint público: si alguna vez se
  // filtrara desde el lado de Mercado Pago, no sirve para nada acá. Sólo
  // tiene valor para paymentMethod=MERCADO_PAGO (generado en
  // mercadoPagoCheckout.service.js, mismo generador — crypto.randomBytes
  // — que el resto de los tokens públicos del proyecto).
  mercadoPagoExternalReference String? @unique

  // MP-6 — `total` sigue siendo, exactamente como siempre, el monto real
  // que paga/pagó el comprador (lo que valida el webhook contra
  // payment.transaction_amount — ver mercadoPagoWebhook.service.js, sin
  // cambios ahí). Lo único que cambia es CÓMO se calcula desde MP-6 en
  // adelante: para paymentMethod=MERCADO_PAGO, total = ticketsSubtotal +
  // serviceFee (comisión de servicio SUMADA, nunca descontada del precio
  // del organizador — ver createSaleForBuyer, sale.service.js). Para
  // MANUAL/Courtesy, total sigue siendo únicamente la suma de
  // SaleItem.subtotal, sin comisión — comportamiento sin cambios.
  total Decimal @db.Decimal(10, 2)

  // MP-6 — snapshot inmutable de la comisión de servicio aplicada a ESTA
  // venta en el momento del checkout, congelado para siempre (nunca se
  // recalcula si después cambian los rangos vigentes desde Developer >
  // Configuración — ver ServiceFeeTier). NULL para toda Sale que nunca
  // tuvo comisión: ventas MANUAL, Courtesy, y cualquier Sale de Mercado
  // Pago anterior a esta migración (nunca se hace backfill retroactivo —
  // esas filas ya cobraron/entregaron en su momento con el modelo
  // anterior). Cuando ambos tienen valor, total = ticketsSubtotal +
  // serviceFee siempre — invariante verificado en el checkout antes de
  // persistir (ver mercadoPagoCheckout.service.js).
  ticketsSubtotal Decimal? @db.Decimal(10, 2)
  serviceFee      Decimal? @db.Decimal(10, 2)

  buyerId String
  buyer   User   @relation(fields: [buyerId], references: [id])

  // DNI del comprador de ESTA venta puntual — preparación para la futura
  // recuperación segura de entradas (todavía no implementada). Va en Sale,
  // no en User, a propósito: un mismo comprador invitado puede terminar con
  // más de un User (uno por cada email distinto que haya usado al comprar,
  // ver getOrCreateGuestBuyer), pero su DNI es el mismo siempre — guardarlo
  // por venta es lo que va a permitir encontrar TODAS sus compras por DNI
  // sin depender de qué email usó en cada una. Nullable: las ventas
  // anteriores a este campo no lo tienen y tienen que seguir funcionando
  // igual (QR, PDF, recuperación por publicRecoveryToken) sin él.
  buyerDocument String?

  eventId    String
  event      Event         @relation(fields: [eventId], references: [id])
  functionId String
  function   EventFunction @relation(fields: [functionId], references: [id])

  items   SaleItem[]
  tickets Ticket[]

  // Quién y cuándo confirmó el pago. confirmedBy queda null cuando la
  // confirmación viene de un webhook automático (Mercado Pago a futuro) en
  // vez de un organizador.
  confirmedAt DateTime?
  confirmedBy String?
  paymentRef  String?

  // MP-2 — sólo tienen valor cuando paymentMethod = MERCADO_PAGO. La Sale
  // sigue naciendo PENDING igual que siempre (ver el comment de arriba del
  // modelo); esto es lo que la conecta con Checkout Pro sin tocar
  // SaleStatus. mercadoPagoPreferenceId/mercadoPagoInitPoint se completan
  // recién cuando Mercado Pago confirma la creación de la preferencia
  // (mercadoPagoCheckout.service.js) — si esa llamada falla, la Sale se
  // cancela y estos quedan null para siempre en esa fila.
  checkoutIdempotencyKey String? @unique
  mercadoPagoPreferenceId String? @unique
  mercadoPagoInitPoint    String?

  // MP-3 — id del payment de Mercado Pago que confirmó ESTA Sale. @unique:
  // nunca dos Sale pueden terminar apuntando al mismo payment (si alguna
  // vez ocurriera por un bug de correlación, Postgres lo rechaza con un
  // conflicto en vez de dejarlo pasar silenciosamente — ver el informe de
  // MP-3). Se escribe DENTRO de la misma transacción atómica que confirma
  // la venta (confirmSaleService), nunca en un paso separado: así no puede
  // quedar una Sale con el payment "reclamado" pero todavía sin confirmar.
  // Null para toda venta manual (paymentMethod=MANUAL) y para cualquier
  // Sale de Mercado Pago que todavía no fue confirmada.
  mercadoPagoPaymentId String? @unique

  // Email de confirmación con los tickets (Resend) — nunca se manda dentro
  // de la transacción que confirma la venta (ver confirmSaleService), y
  // nunca más de una vez por venta aunque confirmSaleService se llame varias
  // veces (reintentos del frontend, polling, StrictMode, retries de red).
  // confirmationEmailAttempts/LastAttemptAt sirven para el reclamo atómico
  // (PENDING/FAILED -> SENDING) y para recuperar un SENDING que quedó
  // colgado por una caída del proceso. confirmationEmailLastError guarda
  // sólo un motivo sanitizado (nunca el error crudo de Resend, nunca datos
  // sensibles) — ver sendSaleConfirmationEmail.service.js.
  confirmationEmailStatus        EmailDeliveryStatus @default(PENDING)
  confirmationEmailSentAt        DateTime?
  confirmationEmailLastAttemptAt DateTime?
  confirmationEmailProviderId    String?
  confirmationEmailAttempts      Int                 @default(0)
  confirmationEmailLastError     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Sólo existe cuando origin = COURTESY — ver CourtesyIssuance.
  courtesy CourtesyIssuance?

  @@map("sales")
}

enum CourtesyReason {
  SPONSOR
  PRENSA
  INVITADO
  STAFF
  ARTISTA
  FAMILIAR
  PROTOCOLO
  OTRO
}

enum CourtesyDeliveryMethod {
  SHARE
  EMAIL
}

// Compañera 1:1 de una Sale con origin=COURTESY — sólo lo que una cortesía
// necesita de más sobre una venta normal (motivo, quién la emitió, cómo se
// entregó). Separada de Sale en vez de agregarle columnas nullable que no
// significan nada para el otro 99% de las filas (mismo criterio que
// TicketQr como compañera 1:1 de Ticket). El "estado" que ve el organizador
// en el Historial (Pendiente/Entregada/Utilizada/Cancelada) NUNCA se guarda
// acá — se calcula al leer, a partir de Sale.status, Ticket.status y
// Sale.confirmationEmailStatus (mismo criterio que el stock: siempre
// derivado, nunca una columna que se pueda desincronizar).
model CourtesyIssuance {
  id String @id @default(cuid())

  saleId String @unique
  sale   Sale   @relation(fields: [saleId], references: [id])

  reason     CourtesyReason?
  reasonNote String?

  deliveryMethod CourtesyDeliveryMethod
  // Sólo tiene valor con deliveryMethod = EMAIL — es el email al que
  // realmente se mandó (mismo email que termina siendo Sale.buyer.email
  // para esta venta, guardado también acá para que el Historial no
  // dependa de resolver el buyer sólo para mostrar la columna
  // "Destinatario").
  recipientEmail String?

  // Quién emitió — nunca null: sólo ORGANIZER/DEVELOPER pueden llegar a
  // crear esta fila (ver requireRole en courtesy.routes.js).
  issuedByUserId String
  issuedBy       User   @relation(fields: [issuedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("courtesy_issuances")
}

// Sesión de verificación por código de 6 dígitos para "Recuperar mis
// entradas" (RecoverPurchase.jsx). Deliberadamente NO vive en Sale ni en
// User: un mismo par email+DNI puede coincidir con 0, 1 o varias Sale (o
// ninguna — ver saleRecoveryVerification.service.js, que nunca revela cuál
// de esos casos ocurrió), así que la sesión es del PAR normalizado, no de
// una venta puntual. Mismos campos y mismo criterio que
// EventScanner.verificationCode* (código en hash, nunca texto plano;
// vencimiento; intentos fallidos; cooldown de reenvío) — misma
// infraestructura de código de Scanner, reutilizada vía
// utils/verificationCode.js y utils/withTimeout.js en vez de reescrita acá.
model SaleRecoveryVerification {
  id String @id @default(cuid())

  // Mismo formato normalizado que Sale.buyerDocument / recoverSalesService
  // (email en minúsculas recortado, DNI sin puntos/espacios/guiones). Este
  // par no es el secreto de la pantalla — el código de 6 dígitos sí lo es;
  // el par sólo identifica una sesión, igual que `invitationToken` identifica
  // una fila de EventScanner.
  normalizedEmail    String
  normalizedDocument String

  codeHash      String?
  codeExpiresAt DateTime?
  attempts      Int       @default(0)
  lastSentAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([normalizedEmail, normalizedDocument])
  @@map("sale_recovery_verifications")
}

// Detalle de qué tipos de entrada y cuántas unidades componen la venta.
// unitPrice/subtotal quedan congelados al momento de la compra: no se
// recalculan si el organizador cambia precios del evento después.
model SaleItem {
  id String @id @default(cuid())

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])

  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)

  // MP-6 — comisión de servicio aplicada a ESTE tipo de entrada, a este
  // precio unitario, en el momento del checkout (congelada igual que
  // unitPrice/subtotal — nunca se recalcula después). serviceFeeUnit es el
  // importe fijo por unidad (según el rango vigente al momento de la
  // compra para unitPrice); serviceFeeSubtotal = serviceFeeUnit × quantity.
  // NULL para todo lo que nunca tuvo comisión (MANUAL, Courtesy, filas
  // anteriores a esta migración) — mismo criterio que Sale.ticketsSubtotal/
  // serviceFee.
  serviceFeeUnit     Decimal? @db.Decimal(10, 2)
  serviceFeeSubtotal Decimal? @db.Decimal(10, 2)

  @@map("sale_items")
}

// MP-6 — configuración autoritativa server-side de la comisión de
// servicio de PaseCultural para Mercado Pago (backend/src/services/
// serviceFee.service.js es la ÚNICA fuente de verdad que la lee/calcula;
// ningún otro código repite estos importes). Reemplaza por completo al
// PLATFORM_FEE_PERCENTAGE fijo del 10% (eliminado) — la comisión ya NO se
// descuenta del precio del organizador, se SUMA como un importe fijo por
// entrada según en qué rango cae su precio unitario.
//
// Modelo: un conjunto de rangos [minAmount, maxAmount) contiguos, sin
// huecos ni superposiciones, con exactamente un último rango
// maxAmount=null (sin límite superior) — validado en
// serviceFee.service.js#validateServiceFeeTiersInput antes de persistir
// (nunca se confía en que la fila ya guardada sea válida sin
// revalidarla). El precio $0 NUNCA consulta esta tabla — está
// hardcodeado en calculateServiceFeeForUnitPrice (comisión $0 siempre),
// así que ninguna configuración acá puede convertir una entrada gratuita
// en una venta paga por accidente.
//
// Guardar cambia el conjunto COMPLETO de forma atómica (delete-all +
// create, una sola transacción — ver replaceServiceFeeTiers): nunca hace
// falta preservar el `id` de un rango entre ediciones, ninguna otra tabla
// referencia esta fila por id — Sale/SaleItem guardan el IMPORTE ya
// calculado (snapshot), nunca una referencia a qué fila de acá se usó,
// exactamente el mismo criterio que SaleItem.unitPrice nunca referencia a
// TicketType.price. Por eso cambiar los rangos desde Developer nunca
// afecta ventas ya confirmadas.
model ServiceFeeTier {
  id String @id @default(cuid())

  minAmount Decimal  @db.Decimal(10, 2)
  // NULL = sin límite superior — exactamente un rango (el último, de mayor
  // precio) debe tenerlo así.
  maxAmount Decimal? @db.Decimal(10, 2)
  feeAmount Decimal  @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Quién guardó esta fila por última vez — nullable porque las 4 filas
  // que trae la migración inicial (ver migration.sql) no las guardó
  // ningún DEVELOPER real, se insertan directamente en la migración para
  // que la comisión esté operativa desde el primer deploy, sin depender
  // de un seed manual.
  updatedByUserId String?
  updatedBy       User?   @relation(fields: [updatedByUserId], references: [id])

  @@map("service_fee_tiers")
}

// Un ticket = una entrada individual escaneable. Se generan recién al
// confirmar la venta (Sale.status -> CONFIRMED), nunca antes.
model Ticket {
  id String @id @default(cuid())

  // Correlativo interno (autoincrement de Postgres, atómico) usado para
  // construir ticketNumber sin condiciones de carrera. No se expone.
  sequence Int @unique @default(autoincrement())
  // Identificador legible y único para soporte/búsqueda. Ej: PC-2026-000123.
  ticketNumber String @unique

  status TicketStatus @default(ACTIVE)

  // Copia de sale.origin al momento de emitir el ticket. Denormalizado a
  // propósito: Prisma no puede agrupar (`groupBy`) por un campo de una
  // relación, así que sin esto el desglose de estadísticas por origen
  // (venta vs. cortesía vs. futuros orígenes) sería imposible de escalar
  // sin tocar código cada vez. Nunca se recalcula ni se usa para lógica
  // comercial — sólo para reportes operativos (functionCapacity.service.js).
  origin SaleOrigin @default(SALE)

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id])

  eventId    String
  event      Event         @relation(fields: [eventId], references: [id])
  functionId String
  function   EventFunction @relation(fields: [functionId], references: [id])

  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])

  // La compra pertenece al buyer; el derecho de uso pertenece al owner.
  // Hoy son siempre el mismo usuario — separarlos deja preparado el sistema
  // para regalar/transferir/revender entradas sin migrar.
  buyerId String
  buyer   User   @relation("TicketBuyer", fields: [buyerId], references: [id])
  ownerId String
  owner   User   @relation("TicketOwner", fields: [ownerId], references: [id])

  qr           TicketQr?
  // Historial de ingresos — ya NO es 1:1 (ver CheckIn más abajo): un ticket
  // reactivado después de USED puede volver a escanearse y sumar un nuevo
  // CheckIn sin perder los anteriores.
  checkIns     CheckIn[]
  scanAttempts ScanAttempt[]
  auditLogs    TicketAuditLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("tickets")
}

// El QR nunca guarda una imagen ni el token en texto plano: el secreto se
// cifra (AES-256-GCM, clave en TICKET_QR_SECRET_KEY, fuera de la base) antes
// de persistirse. Reversible solo con esa clave del servidor — un dump de la
// base sola no alcanza para reconstruir el secreto — y permite que
// GET /tickets/:id/qr devuelva siempre el mismo QR en visitas futuras (un
// hash de una vía no lo hubiera permitido).
model TicketQr {
  id String @id @default(cuid())

  ticketId String @unique
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  secretEncrypted String
  createdAt       DateTime  @default(now())
  usedAt          DateTime?
  rotatedAt       DateTime? // última regeneración del secret (previsto, no implementado aún)

  @@map("ticket_qrs")
}

// Historial de ingresos de un ticket — a propósito NO es 1:1 (sin @unique
// en ticketId): un ticket puede reactivarse después de USED (ver
// TicketAuditLog) y volver a escanearse, y cada ingreso real queda como una
// fila propia, nunca se pisa ni se borra la anterior. Para "¿cuándo entró
// por última vez?" se consulta con findFirst + orderBy(scannedAt desc), no
// findUnique — ver validateScanService.
model CheckIn {
  id String @id @default(cuid())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  // SCAN = lo creó un escaneo real de QR (validateScanService). MANUAL = lo
  // cargó un organizador a mano (markTicketUsedManuallyService), sin QR de
  // por medio — por eso scannerId es nullable acá pero no en un SCAN real.
  source    CheckInSource @default(SCAN)
  // Antes "scannedBy": id de EventScanner. Renombrado porque un check-in
  // MANUAL no tiene un scanner real detrás — null en ese caso.
  scannerId String?
  gate      String? // "Puerta Norte", "VIP", "Ingreso A"... opcional por ahora
  device    String? // user-agent del dispositivo que escaneó, mismo dato que ya guarda ScanAttempt.userAgent

  scannedAt DateTime @default(now())

  // scannerId sigue sin ser una relación formal (ver comentario de arriba),
  // pero desde la Iteración 1 del Dashboard se agrupa por acá para calcular
  // "ingresos por scanner" en tiempo real (organizerEventScanner stats) — sin
  // este índice, ese groupBy escanea toda la tabla.
  @@index([scannerId])
  @@map("check_ins")
}

// Log de auditoría de TODOS los intentos de escaneo (válidos o no) —
// distinto de CheckIn, que es solo el ingreso válido. Permite detectar
// QRs reusados/compartidos y auditar quién escaneó qué y cuándo.
model ScanAttempt {
  id String @id @default(cuid())

  // ticketId es null sólo cuando el token ni siquiera resolvió a un ticket
  // real (NOT_FOUND de un id inexistente). Cuando no es null, siempre
  // apunta a un Ticket real — por eso es una relación de verdad (permite
  // recorrer hasta function/ticketType/buyer para el historial del scanner
  // sin una segunda query manual), no sólo un id suelto.
  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id])

  eventId   String
  result    ScanResult
  scannedBy String
  scannedAt DateTime   @default(now())

  // A diferencia de CheckIn.gate (que sólo existe para el ingreso válido),
  // acá faltaba: un intento ALREADY_USED/WRONG_EVENT/etc. no dejaba
  // registrado en qué puerta ocurrió. Nullable, mismo criterio que gate en
  // CheckIn.
  gate String?

  ip        String?
  userAgent String?

  @@map("scan_attempts")
}

enum CheckInSource {
  SCAN
  MANUAL
}

enum TicketAuditAction {
  CANCEL
  REHABILITATE
  REACTIVATE
  MARK_USED_MANUAL
  SOFT_DELETE
}

enum TicketAuditActorType {
  SCANNER
  ORGANIZER
  SYSTEM
}

// Bitácora append-only de TODA acción administrativa sobre un ticket
// (nunca de un escaneo normal — eso ya lo cubren CheckIn/ScanAttempt). Por
// convención de código nunca se actualiza ni se borra una fila de acá
// (mismo criterio no forzado por la base que ya tiene ScanAttempt) — sólo
// se crean filas nuevas. fromStatus/toStatus quedan null cuando la acción
// no cambia Ticket.status (ej. SOFT_DELETE, que sólo toca deletedAt).
model TicketAuditLog {
  id String @id @default(cuid())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  action     TicketAuditAction
  fromStatus TicketStatus?
  toStatus   TicketStatus?

  // actorId guarda User.id cuando actorType es ORGANIZER, o EventScanner.id
  // cuando es SCANNER — null cuando es SYSTEM (proceso automático, todavía
  // sin ningún caller hoy). Mismo criterio de String suelto (sin relación
  // formal) que ya usan CheckIn.scannerId/ScanAttempt.scannedBy.
  actorType TicketAuditActorType
  actorId   String?
  reason    String?
  // Reservado para detalle estructurado futuro — ningún caller lo llena
  // todavía.
  metadata  Json?

  createdAt DateTime @default(now())

  @@map("ticket_audit_logs")
}

// Ciclo de vida de una invitación de scanner — SIN aprobación manual:
//   INVITED  -> el organizador la creó. Puede seguir así indefinidamente
//               (nadie completó el registro todavía) o tener un código de
//               verificación pendiente (ver verificationCodeHash) mientras
//               alguien está a mitad del registro — sigue siendo INVITED,
//               no hay un estado intermedio propio para eso.
//   ACTIVE   -> el código de 6 dígitos fue verificado correctamente. Pasa
//               DIRECTO de INVITED a ACTIVE: el organizador ya autorizó
//               implícitamente al generar la invitación, no hay una
//               segunda aprobación.
//   DISABLED -> fue ACTIVE, el organizador la desactivó temporalmente
//               (reversible con "Reactivar", vuelve a ACTIVE).
//   REVOKED  -> cancelada — terminal, no se reactiva; si hace falta, el
//               organizador genera una invitación nueva.
enum EventScannerStatus {
  INVITED
  ACTIVE
  DISABLED
  REVOKED
}

// Una fila = un scanner (persona real u "slot" todavía sin registrar) para
// UN evento puntual — nunca escanea otro evento (ver requireScannerSession).
// El link lleva sólo `invitationToken` (nunca el `id` interno). Se activa
// registrándose (nombre/apellido/DNI/email/teléfono) y verificando un código
// de 6 dígitos mandado por email — SIN Clerk, SIN cuentas, en ningún paso:
// ni para registrarse ni para escanear después. La sesión completa (alta y
// uso del lector QR) se resuelve con un scannerSessionToken propio (JWT
// firmado con SCANNER_SESSION_SECRET, ver config/scannerSession.js) que
// identifica directamente esta fila por `id` — nunca un User.
model EventScanner {
  id String @id @default(cuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // "Puerta Principal #1" — lo arma el motor a partir de gate+índice al
  // crear el lote, después editable por el organizador sin tocar `gate`.
  name String
  // "Puerta Principal" tal cual lo eligió/escribió el organizador en el
  // paso 2 del asistente — se conserva aparte de `name` para poder generar
  // más scanners de la misma puerta más adelante sin tener que parsearlo.
  gate String

  status EventScannerStatus @default(INVITED)

  // Credencial pública del link de invitación — nunca el `id` interno,
  // mismo criterio que publicRecoveryToken en Sale.
  invitationToken     String    @unique
  invitationExpiresAt DateTime?

  // Datos que la persona completa en el paso 3 del registro público — única
  // identidad que se guarda de esta persona, no hay User/cuenta detrás.
  // Nullable: siguen sin valor mientras el estado es INVITED y todavía
  // nadie completó el formulario. `email` además es la clave que evita que
  // la misma persona quede activa dos veces para el mismo evento — a
  // propósito NO es un @@unique de base: una fila REVOKED conserva su
  // email para el historial/auditoría, y no debe bloquear que se
  // registre un reemplazo con ese mismo email más adelante. El candado
  // real es a nivel de aplicación (ver verifyScannerInvitationCodeService,
  // que excluye status REVOKED de la comprobación).
  firstName String?
  lastName  String?
  document  String? // DNI — mismo formato/validación que Sale.buyerDocument
  email     String?
  phone     String?

  // Verificación por código de 6 dígitos (reemplaza la aprobación manual).
  // Nunca se guarda el código en texto plano: sólo su hash (SHA-256). Un
  // código nuevo pisa al anterior (no hay múltiples códigos vivos a la vez
  // por fila). verificationAttempts cuenta intentos fallidos consecutivos
  // contra ESTE código — llegar al máximo obliga a pedir uno nuevo
  // (resend), que resetea el contador. verificationLastSentAt sirve para el
  // cooldown de reenvío (compare-and-swap, ver registerScannerInvitationService/
  // resendScannerVerificationCodeService) y se limpia a null si el envío
  // por Resend falla, para no dejar a alguien bloqueado por un código que
  // nunca llegó.
  verificationCodeHash      String?
  verificationCodeExpiresAt DateTime?
  verificationAttempts      Int       @default(0)
  verificationLastSentAt    DateTime?

  // Auditoría (quién hizo qué y cuándo) — ver requerimiento explícito del
  // módulo de gestión de scanners.
  createdBy    String // User.id del organizador que generó la invitación
  claimedAt    DateTime? // cuándo se completó el formulario de registro (paso 3)
  activatedAt  DateTime? // cuándo se verificó el código y pasó a ACTIVE
  lastAccessAt DateTime? // última vez que este scanner abrió la app (ver listScannerEventsService)
  lastDevice   String? // user-agent capturado en la verificación/último acceso — sólo informativo
  lastScanAt   DateTime? // preparado para cuando el lector QR esté activo; no se usa todavía

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Soporte multi-evento: findActiveScannerByEmail (login) y
  // resolveScannerAccess (autorización por evento) filtran por email en
  // cada request de un scanner con más de una asignación — sin índice,
  // full scan de la tabla. No es @@unique a propósito (ver comentario de
  // `email` arriba): la misma persona puede tener varias filas ACTIVE.
  @@index([email])
  @@map("event_scanners")
}
