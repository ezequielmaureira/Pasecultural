# backend/.env — plantilla para DESARROLLO normal (no tests).
#
# Copiá este archivo a `backend/.env` (queda ignorado por git) y completá
# con tus propias credenciales. NUNCA copies acá valores reales de
# producción, de Fly, de Vercel ni de ningún .env ya cargado.
#
# Para los tests que usan Prisma real (`npm run test:db` / `npm test`),
# usá en cambio `backend/.env.test`, basado en `backend/.env.test.example`
# — debe apuntar exclusivamente al proyecto Supabase de TEST, nunca a este.

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database (PostgreSQL / Supabase, vía Prisma) ---
DATABASE_URL=postgresql://usuario:password@host-de-tu-proyecto:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://usuario:password@host-de-tu-proyecto:5432/postgres

# --- Clerk (autenticación) ---
# Leída por @clerk/express por convención del SDK (no aparece como
# process.env.CLERK_SECRET_KEY explícito en el código, pero es obligatoria
# para que clerkMiddleware() funcione).
CLERK_SECRET_KEY=your_value_here

# --- Seguridad / firmas internas ---
SCANNER_SESSION_SECRET=your_value_here
TICKET_QR_SECRET_KEY=your_value_here
MERCADOPAGO_TOKEN_SECRET_KEY=your_value_here

# --- Mercado Pago ---
MERCADOPAGO_CLIENT_ID=your_value_here
MERCADOPAGO_CLIENT_SECRET=your_value_here
MERCADOPAGO_REDIRECT_URI=your_value_here
MERCADOPAGO_WEBHOOK_SECRET=your_value_here
MERCADOPAGO_NOTIFICATION_URL=your_value_here
# Opcional: casilla interna que recibe la alerta cuando Mercado Pago aprueba
# un pago que el sistema no pudo cumplir por falta de stock.
MERCADOPAGO_RECONCILIATION_ALERT_EMAIL=your_value_here

# --- Resend (emails) ---
RESEND_API_KEY=your_value_here
EMAIL_FROM=Smarticket <no-reply@tu-dominio>
# Opcional
EMAIL_REPLY_TO=your_value_here

# --- Cloudinary (media) ---
CLOUDINARY_CLOUD_NAME=your_value_here
CLOUDINARY_API_KEY=your_value_here
CLOUDINARY_API_SECRET=your_value_here

# --- WhatsApp / Meta Cloud API ---
WHATSAPP_ACCESS_TOKEN=your_value_here
WHATSAPP_PHONE_NUMBER_ID=your_value_here
WHATSAPP_VERIFY_TOKEN=your_value_here
WHATSAPP_APP_SECRET=your_value_here
WHATSAPP_GRAPH_API_VERSION=your_value_here
WHATSAPP_DISPLAY_PHONE_NUMBER=your_value_here
# Opcional
WHATSAPP_TEST_MODE=false
# Opcional, sólo diagnóstico de performance
WHATSAPP_PERF_LOG=false

# --- Google Maps (server-side, geocoding) ---
GOOGLE_MAPS_SERVER_API_KEY=your_value_here

# --- Frontend / URLs ---
# URL pública del frontend — usada para armar links (recuperación de compra,
# redirecciones de OAuth de Mercado Pago, etc.)
FRONTEND_URL=http://localhost:5173

# --- Alertas internas (Developer) ---
# Opcional: casilla que recibe alertas internas de riesgo de plataforma.
DEVELOPER_ALERT_EMAIL=your_value_here

# --- Inyectadas automáticamente por la plataforma de hosting ---
# RENDER_GIT_COMMIT — la setea Render en cada deploy. NO configurar a mano
# en local ni en Fly.
