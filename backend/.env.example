# Base de datos (Supabase / Postgres)
DATABASE_URL=
DIRECT_URL=

# Clerk (autenticación)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Cloudinary (imágenes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cifrado del secreto del QR de las entradas (AES-256-GCM).
# Debe ser una clave de exactamente 32 bytes, codificada en base64 estándar
# (NO base64url — nada de "-"/"_", sólo "+"/"/"). Un valor válido en base64
# estándar mide 44 caracteres y termina en "=".
#
# Generarla con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Ejemplo de FORMATO válido (no usar este valor, es sólo ilustrativo):
#   TICKET_QR_SECRET_KEY=rJ/Nz0GmxdQXrFOoZ4Vl1RczPLuqWIQDOI2GSPt/0mc=
#
# Si falta o tiene un largo distinto a 32 bytes decodificados, el servidor
# arranca igual (validación diferida) pero cualquier compra o escaneo de
# entradas va a fallar hasta que se configure.
TICKET_QR_SECRET_KEY=

PORT=3000
