# frontend/.env — plantilla para DESARROLLO local.
#
# Copiá a `frontend/.env` (ignorado por git) y completá con tus propios
# valores. Vite sólo expone al cliente las variables con prefijo VITE_.
# Nunca pongas acá secrets de backend (Resend, Cloudinary, Mercado Pago,
# WhatsApp, etc.) — este archivo termina en el bundle público del navegador.

# URL base del backend (API)
VITE_API_URL=http://localhost:3000

# Clerk — clave PUBLICABLE (no confundir con CLERK_SECRET_KEY del backend)
VITE_CLERK_PUBLISHABLE_KEY=your_value_here

# Google Maps (uso client-side: autocompletado de ubicación)
VITE_GOOGLE_MAPS_API_KEY=your_value_here
