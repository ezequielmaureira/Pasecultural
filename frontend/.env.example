# URL base del backend. Si se omite, se usa http://localhost:3000.
# VITE_API_URL=http://localhost:3000

# Clave pública de Clerk para autenticación en el frontend.
VITE_CLERK_PUBLISHABLE_KEY=

# Clave pública (restringida) de Google Maps, usada por LocationPicker/LocationMap
# para el paso "Programación" del wizard de eventos y para la vista pública del evento.
#
# APIs de Google Cloud que hay que activar en el proyecto:
#   - Maps JavaScript API   (renderiza el mapa y el marcador)
#   - Places API            (autocomplete de direcciones + detalle del lugar)
#   - Geocoding API         (reverse geocoding al mover el marcador)
#
# Configuración obligatoria en Google Cloud Console > Credenciales:
#   - Restringir la key por "HTTP referrers (websites)" a los dominios donde
#     corre el frontend (ej: http://localhost:5173/*, https://tu-dominio.com/*).
#   - Restringir la key a únicamente las 3 APIs de arriba ("API restrictions").
#   - Configurar cuotas diarias y alertas de facturación para esta key,
#     ya que es una clave pública embebida en el bundle del navegador.
#
# Sin esta variable, LocationPicker y LocationMap muestran un mensaje de
# configuración faltante en vez de romper la aplicación.
VITE_GOOGLE_MAPS_API_KEY=
